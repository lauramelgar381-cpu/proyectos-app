# Copia este archivo a .env y ajusta los valores
# Cadena de conexión de MongoDB (la misma que usas en Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/proyectos_app
PORT=3000

# Acceso de administrador
# Usuario para iniciar sesión
ADMIN_USER=admin
# Hash bcrypt de tu contraseña. Genéralo con: npm run crear-hash -- "tu-contraseña"
# Va entre comillas simples porque contiene el carácter $
ADMIN_PASSWORD_HASH=''
# Texto largo y aleatorio para firmar los tokens. No lo compartas
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
